{
  "name": "kilowattx",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:setup": "node scripts/setup-test-databases.mjs && node scripts/setup-pgboss.mjs --test",
    "db:generate": "pnpm --filter @kilowattx/db generate",
    "db:migrate": "pnpm --filter @kilowattx/db migrate",
    "dev:api": "pnpm --filter @kilowattx/api start:dev",
    "dev:web": "pnpm --filter @kilowattx/web dev",
    "dev:worker": "pnpm --filter @kilowattx/worker start:dev",
    "walkthrough:land": "node scripts/walkthrough-land.mjs",
    "pgboss:setup": "node scripts/setup-pgboss.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.5"
  },
  "pnpm": {
    "dedupePeerDependents": true
  }
}
