# ===================================================================
# KiloWattX KYC — environment
# ===================================================================
#
# Copy this file to `.env` and fill it in:
#
#     cp .env.example .env
#
# `.env` is gitignored. This file is not, so it must never hold a real
# key — only the shape of one.
#
# Loaded by apps/api and apps/worker at startup. A variable already set in
# the real environment WINS over the same name here, so a stray .env left in
# a production image cannot override what the platform injected.

# -------------------------------------------------------------------
# Database
# -------------------------------------------------------------------
# The application role, never the owner. The owner can bypass row-level
# security, which is the one thing standing between a missing WHERE clause
# and every customer's KYC record.
DATABASE_URL=postgresql://kilowattx_app:local_dev_only@localhost:5433/kilowattx

# -------------------------------------------------------------------
# The verification gateway
# -------------------------------------------------------------------
# fake     — verifies nobody, simulates the gateway. Refused in production.
# sandbox  — sandbox.co.in (Quicko). Primary.
# cashfree — the failover. Adapter not written yet.
KYC_PROVIDER=fake

# From the Sandbox dashboard. Test keys talk to test-api.sandbox.co.in and
# live keys to api.sandbox.co.in — the adapter picks the host from NODE_ENV,
# so a test key in production fails loudly rather than quietly verifying
# nobody.
KYC_VENDOR_CLIENT_ID=
KYC_VENDOR_CLIENT_SECRET=

# -------------------------------------------------------------------
# Secrets we generate ourselves — nobody issues these
# -------------------------------------------------------------------
# Generate each one fresh. Do not reuse a value between them: they protect
# different things in different directions, and one key that both verifies
# vendor callbacks and grants access to land deeds means a leak of either is
# a leak of both. loadConfig() refuses it outright.

# Verifies inbound gateway callbacks.
#   node -e "console.log('whsec_' + require('crypto').randomBytes(24).toString('hex'))"
KYC_WEBHOOK_SECRET=

# 32 bytes, base64. Keys the duplicate-PAN blind index. Rotating this means
# recomputing every index, so plan it as a migration rather than a change.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KYC_BLIND_INDEX_KEY=

# Signs the short-lived document URLs. Minimum 24 characters.
#   node -e "console.log('filesign_' + require('crypto').randomBytes(24).toString('hex'))"
FILE_SIGNING_SECRET=

# -------------------------------------------------------------------
# Optional — sensible defaults apply if these are left out
# -------------------------------------------------------------------
# NODE_ENV=development
# PORT=4000
# KYC_REDIRECT_URL=http://localhost:3000/kyc/return
# FILE_BASE_URL=http://localhost:4000/v1/files
# FILE_BUCKET_ROOT=.kwx-bucket
