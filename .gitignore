node_modules/
.turbo/
dist/
.next/

# The development object store. Uploaded KYC documents land here — land
# records, deeds, selfies. None of it belongs in version control, and
# LocalDiskBucket refuses to run in production precisely because this is not
# real storage.
.kwx-bucket/
apps/*/.kwx-bucket/

# Secrets are read from the shell, not a file, but a stray one must not be
# committed by accident.
.env
.env.*
!.env.example

.walk/
*.log

# TypeScript's incremental build cache. It records absolute paths and file
# timestamps from whichever machine ran `tsc`, so a committed one is dirty
# again the moment anybody typechecks — and it conflicts on every merge while
# telling a reviewer nothing.
*.tsbuildinfo
